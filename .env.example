# Nami Chain Local Setup Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Chain Configuration
CHAIN_ID=nami_101012026-1
MONIKER=namitestnet

# Supply Allocation (70% validator, 30% community)
VALIDATOR_AMOUNT=700000000000000nami
COMMUNITY_AMOUNT=300000000000000nami

# Mnemonics (optional - if not provided, new keys will be generated)
# If you want to reuse existing keys, uncomment and fill in:
# VALIDATOR_MNEMONIC="your validator mnemonic phrase here"
# COMMUNITY_MNEMONIC="your community mnemonic phrase here"
